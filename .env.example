# NIGHTHAWK Environment Configuration
# Copy to .env for local development.
# All keys use the NIGHTHAWK_ prefix (see nighthawk/config/config.py).

# Database
NIGHTHAWK_DATABASE_URL=sqlite:///./nighthawk.db
NIGHTHAWK_DB_ECHO=false

# API
NIGHTHAWK_API_HOST=0.0.0.0
NIGHTHAWK_API_PORT=8000
NIGHTHAWK_API_DEBUG=false
NIGHTHAWK_API_WORKERS=1

# API security (opt-in)
# Set NIGHTHAWK_API_TOKEN to require `Authorization: Bearer <token>` on every
# /api/v1 route. Leave empty to disable auth (local development only).
NIGHTHAWK_API_TOKEN=
# Comma-separated allowed browser origins, e.g.
#   NIGHTHAWK_CORS_ORIGINS=https://app.example.com,http://localhost:3000
# Leave empty to disable CORS entirely.
NIGHTHAWK_CORS_ORIGINS=

# Scope / Safety
NIGHTHAWK_DEFAULT_SCOPE_PATH=./scope.yaml
NIGHTHAWK_MAX_CONCURRENCY=10
NIGHTHAWK_RATE_LIMIT_RPS=5
NIGHTHAWK_REQUEST_TIMEOUT=10.0

# Logging
NIGHTHAWK_LOG_LEVEL=INFO
NIGHTHAWK_STRUCTLOG_DEV_MODE=false

# Security / Redaction
NIGHTHAWK_REDACT_SECRETS=true
NIGHTHAWK_REDACT_REPORTS=true

# Platform
NIGHTHAWK_PLATFORM=linux
