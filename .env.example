# NIGHTHAWK Environment Configuration
# Copy to .env for local development

# Database
DATABASE_URL=sqlite:///./nighthawk.db
DB_TYPE=sqlite
DB_ECHO=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Scope / Safety
NIGHTHAWK_DEFAULT_SCOPE=./scope.yaml
NIGHTHAWK_MAX_CONCURRENCY=10
NIGHTHAWK_RATE_LIMIT_RPS=5

# Logging
LOG_LEVEL=INFO
STRUCTLOG_DEV_MODE=false

# Security / Redaction
REDACT_SECRETS=true
REDACT_REPORTS=true

# Platform
PLATFORM=linux
